{
  "name": "Id2num",
  "description": "Telegram ID to Number OSINT Bot",
  "repository": "https://github.com/oyevipthoma88/Id2num",
  "logo": "https://telegra.ph/file/24fa902ead26340f3df2c.png",
  "keywords": ["telegram", "osint", "bot", "id2num"],
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram Bot Token from @BotFather",
      "value": "",
      "required": true
    },
    "API_ID": {
      "description": "Telegram API ID from https://my.telegram.org",
      "value": "",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API HASH from https://my.telegram.org",
      "value": "",
      "required": true
    },
    "MONGODB_URI": {
      "description": "MongoDB connection string (from https://mongodb.com/atlas)",
      "value": "",
      "required": true
    },
    "API_URL": {
      "description": "External OSINT API URL",
      "value": "https://tele-to-num-by-dimpiii.vercel.app/api/tele",
      "required": false
    },
    "API_KEY": {
      "description": "API Key for the OSINT API",
      "value": "dimpiii-modz",
      "required": false
    },
    "OWNER_ID": {
      "description": "Owner Telegram User ID (numeric)",
      "value": "",
      "required": false
    }
  },
  "buildpacks": [
    { "url": "heroku/python" }
  ],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
